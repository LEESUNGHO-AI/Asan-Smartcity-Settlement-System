{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leesungho-ai.github.io/asan-sms/schema/assets.schema.json",
  "title": "중요재산 대장",
  "description": "보조금법 §35 및 통합관리지침 §46~48. 취득가액 50만원 초과 재산이 대상이며 취득 후 15일 이내 보고 의무. 처분제한기간 종료 전까지 매년 6월·12월 변동현황 보고.",
  "type": "object",
  "required": ["레코드"],
  "additionalProperties": false,

  "properties": {
    "$schema": { "type": "string" },
    "갱신일시": { "$ref": "common.schema.json#/$defs/일시" },

    "레코드": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "자산ID", "재산구분", "재산명", "수량", "취득가액",
          "취득일", "설치장소", "관리주체", "감사추적"
        ],
        "additionalProperties": false,

        "properties": {
          "자산ID": { "type": "string", "pattern": "^AS-[0-9]{4}-[0-9]{4}$" },
          "기관": { "$ref": "common.schema.json#/$defs/기관코드" },
          "단위사업": { "$ref": "common.schema.json#/$defs/단위사업코드" },
          "재산구분": { "$ref": "common.schema.json#/$defs/재산구분" },
          "재산명": { "type": "string", "minLength": 1 },
          "규격": { "type": "string" },
          "관리번호": { "type": "string", "description": "S/N 또는 자산관리번호" },
          "수량": { "type": "integer", "minimum": 1 },
          "취득가액": { "$ref": "common.schema.json#/$defs/금액" },
          "취득일": { "$ref": "common.schema.json#/$defs/날짜" },
          "설치장소": { "type": "string", "minLength": 1 },
          "재원구성": { "$ref": "common.schema.json#/$defs/재원구성" },
          "관리주체": {
            "type": "string",
            "description": "재산의 귀속·관리 주체(예: 아산시, 호서대학교). 준공 전 확정 필수"
          },
          "운영주체": { "type": "string" },

          "처분제한": {
            "type": "object",
            "required": ["기간_년", "만료일"],
            "additionalProperties": false,
            "properties": {
              "기간_년": {
                "type": "integer",
                "enum": [5, 10],
                "description": "부동산·선박·항공기 10년 / 기타 기계·장비 5년(통합관리지침 §46③)"
              },
              "만료일": { "$ref": "common.schema.json#/$defs/날짜" },
              "부기등기": {
                "type": "object",
                "description": "부동산인 경우 보조금법 §35의2에 따른 부기등기 필요",
                "additionalProperties": false,
                "properties": {
                  "필요여부": { "type": "boolean" },
                  "등기일": { "$ref": "common.schema.json#/$defs/날짜" },
                  "등기소": { "type": "string" }
                }
              }
            }
          },

          "보고": {
            "type": "object",
            "description": "취득보고 및 반기 변동보고 이력",
            "additionalProperties": false,
            "properties": {
              "취득보고일": { "$ref": "common.schema.json#/$defs/날짜" },
              "보고처": { "type": "string" },
              "변동보고이력": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["보고일", "구분"],
                  "additionalProperties": false,
                  "properties": {
                    "보고일": { "$ref": "common.schema.json#/$defs/날짜" },
                    "구분": { "type": "string", "enum": ["6월정기", "12월정기", "수시"] },
                    "변동내용": { "type": "string" }
                  }
                }
              }
            }
          },

          "증빙ID": {
            "type": "array",
            "items": { "type": "string", "pattern": "^EV-[0-9]{4}-[0-9]{5}$" },
            "description": "evidence.json 역참조. 취득가액과 증빙 합계 일치 검사(R-06)"
          },
          "계약ID": { "type": ["string", "null"], "pattern": "^CT-[0-9]{4}-[0-9]{4}$" },
          "상태": {
            "type": "string",
            "enum": ["취득", "보고완료", "운영중", "처분승인신청", "처분완료", "폐기"]
          },
          "파일링크": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/URL" } },
          "비고": { "type": "string" },
          "감사추적": { "$ref": "common.schema.json#/$defs/감사추적" }
        }
      }
    }
  }
}
