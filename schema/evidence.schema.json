{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leesungho-ai.github.io/asan-sms/schema/evidence.schema.json",
  "title": "정산 증빙대장",
  "description": "「보조사업 집행결과 제출 양식」의 3.보조비목별 총괄명세서, 4.일자별 집행내역, 4-1.세부집행내역을 모두 생성하는 원천 데이터. 1건 = 1지출건. 검토상태가 '확정'인 레코드만 보고서에 반영된다.",
  "type": "object",
  "required": ["레코드"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "갱신일시": { "$ref": "common.schema.json#/$defs/일시" },
    "레코드": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["증빙ID","기관","단위사업","보조비목","비목코드","보조세목","세목코드","재원","지급처","집행일자","집행금액","사용목적","지급방식","검토상태","감사추적"],
        "additionalProperties": false,
        "properties": {
          "증빙ID": { "type": "string", "pattern": "^EV-[0-9]{4}-[0-9]{5}$", "description": "부여 후 변경 금지. 삭제 대신 검토상태를 '불인정'으로 전환" },
          "기관": { "$ref": "common.schema.json#/$defs/기관코드" },
          "단위사업": { "$ref": "common.schema.json#/$defs/단위사업코드" },
          "보조비목": { "$ref": "common.schema.json#/$defs/보조비목" },
          "비목코드": { "$ref": "common.schema.json#/$defs/비목코드" },
          "보조세목": { "type": "string", "minLength": 1 },
          "세목코드": { "$ref": "common.schema.json#/$defs/세목코드" },
          "세부구분": { "type": "string", "description": "세부집행내역에서 세목을 다시 나눌 때 사용. 예: 일반수용비(01) 아래 '일반수용비' / '회의비'" },
          "재원": { "$ref": "common.schema.json#/$defs/재원" },
          "계약ID": { "type": ["string","null"], "pattern": "^CT-[0-9]{4}-[0-9]{4}$" },
          "지급처": { "$ref": "common.schema.json#/$defs/지급처" },
          "집행일자": { "$ref": "common.schema.json#/$defs/날짜" },
          "집행금액": { "$ref": "common.schema.json#/$defs/금액", "description": "실제 지급액(양식의 '집행금액'). 총괄명세서·일자별 집행내역의 집계 기준" },
          "공급가액": { "$ref": "common.schema.json#/$defs/금액" },
          "부가세": { "$ref": "common.schema.json#/$defs/금액" },
          "사용목적": { "type": "string", "minLength": 1, "description": "양식의 '사용목적' 열에 그대로 출력됨. 사업 관련성이 드러나도록 구체적으로 기재" },
          "지급방식": { "$ref": "common.schema.json#/$defs/지급방법" },
          "증빙유형": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/증빙유형" }, "description": "확보된 증빙 종류. R-05·R-08 검사에 사용" },
          "파일링크": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/URL" } },
          "자산ID": { "type": ["string","null"], "pattern": "^AS-[0-9]{4}-[0-9]{4}$", "description": "유형·무형자산 취득건은 중요재산대장 연결 필수(R-06)" },
          "귀속월": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$", "description": "인건비 참여율 합계 검사(R-08d) 기준월" },
          "승인인력여부": { "type": "boolean" },
          "선금여부": { "type": "boolean", "description": "선금 집행건은 준공·기성으로 반드시 정산되어야 함(R-20)" },
          "검토상태": { "$ref": "common.schema.json#/$defs/검토상태" },
          "보완사유": { "type": "string" },
          "검증확인": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "검증기관": { "type": "string" },
              "확인일": { "$ref": "common.schema.json#/$defs/날짜" },
              "결과": { "type": "string", "enum": ["적정","불인정","조건부"] },
              "불인정금액": { "$ref": "common.schema.json#/$defs/금액" },
              "사유": { "type": "string" }
            }
          },
          "비고": { "type": "string" },
          "감사추적": { "$ref": "common.schema.json#/$defs/감사추적" }
        }
      }
    }
  }
}
